{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "druckwerk",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "druckwerk-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "prod"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    },
    {
      "name": "druckwerk-prod-http",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "HTTPS=false",
        "npm",
        "run",
        "prod"
      ],
      "port": 3000,
      "url": "http://localhost:3000"
    }
  ]
}

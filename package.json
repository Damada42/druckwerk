{
  "name": "3dapp",
  "private": true,
  "version": "0.1.0",
  "description": "3D-Druck-Manager: Projekte, Kunden, Filament und Drucker verwalten",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "npm run build && playwright test --headed",
    "e2e:report": "playwright show-report e2e-report",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
